rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read: if true;
    }
    match /denture_records/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.hn is string;
      allow update: if request.resource.data.hn is string;
      allow delete: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
