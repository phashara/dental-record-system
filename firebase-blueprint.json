{
  "entities": {
    "DentureRecord": {
      "title": "DentureRecord",
      "description": "A dental prosthesis / denture service record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "hn": { "type": "string", "maxLength": 64 },
        "patientName": { "type": "string", "maxLength": 256 },
        "age": { "type": "string", "maxLength": 32 },
        "gender": { "type": "string", "maxLength": 32 },
        "date": { "type": "string", "maxLength": 32 },
        "doctor": { "type": "string", "maxLength": 128 },
        "dentureType": { "type": "string", "maxLength": 128 },
        "denturePosition": { "type": "string", "maxLength": 128 },
        "coverage": { "type": "string", "maxLength": 128 },
        "coverageGroup": { "type": "string", "maxLength": 128 },
        "labCost": { "type": "number" },
        "treatmentFee": { "type": "number" },
        "diagnosis": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "maxLength": 128 },
        "note": { "type": "string", "maxLength": 1000 },
        "source": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["hn", "patientName", "doctor", "dentureType"]
    }
  },
  "firestore": {
    "/denture_records/{recordId}": {
      "schema": "DentureRecord",
      "description": "Collection of denture treatment and laboratory records"
    }
  }
}
